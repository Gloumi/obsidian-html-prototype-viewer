{
	"name": "html-prototype-viewer",
	"version": "1.0.0",
	"description": "Preview local HTML files in an isolated iframe inside Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"install-local": "node scripts/install-local.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.13.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"typescript": "^5.8.0"
	}
}
